@model IEnumerable<(HealthDesk.Domain.Entities.ApplicationUser User, string Roles)>
@{
    ViewData["Title"] = "User Management";
    ViewData["ActiveMenu"] = "Users";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-shield-lock-fill text-primary me-2"></i>
            User Management
        </h4>
        <p class="text-muted mb-0">Manage system users and roles</p>
    </div>
    @* <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create User
    </a> *@
    <a asp-area="Admin"
       asp-controller="UserManagement"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create User
    </a>

</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-people me-2 text-primary"></i>
        All Users
        <span class="badge bg-primary-subtle text-primary ms-2">
            @Model.Count()
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Joined</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.User.FullName</td>
                            <td>@item.User.Email</td>
                            <td>
                                @foreach (var role in item.Roles.Split(", "))
                                {
                                    <span class="badge bg-primary-subtle text-primary me-1">
                                        @role
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.User.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-muted">
                                @item.User.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>