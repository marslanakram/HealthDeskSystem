@model IEnumerable<HealthDesk.Application.DTOs.AuditLogDto>
@{
    ViewData["Title"] = "Audit Log";
    ViewData["ActiveMenu"] = "AuditLog";

}


<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-clock-history text-primary me-2"></i>
            Audit Log
        </h4>
        <p class="text-muted mb-0">System activity history</p>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Action</label>
                <select name="auditAction" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    <option value="Created"
                            selected="@(ViewData["Action"]?.ToString() == "Created")">
                        Created
                    </option>
                    <option value="Updated"
                            selected="@(ViewData["Action"]?.ToString() == "Updated")">
                        Updated
                    </option>
                    <option value="Deleted"
                            selected="@(ViewData["Action"]?.ToString() == "Deleted")">
                        Deleted
                    </option>
                    <option value="Login"
                            selected="@(ViewData["Action"]?.ToString() == "Login")">
                        Login
                    </option>
                    <option value="Logout"
                            selected="@(ViewData["Action"]?.ToString() == "Logout")">
                        Logout
                    </option>
                    <option value="PermissionChanged"
                            selected="@(ViewData["Action"]?.ToString() == "PermissionChanged")">
                        Permission Changed
                    </option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Entity</label>
                <select name="entity" class="form-select form-select-sm">
                    <option value="">All Entities</option>
                    <option value="Patient"
                            selected="@(ViewData["Entity"]?.ToString() == "Patient")">
                        Patient
                    </option>
                    <option value="Doctor"
                            selected="@(ViewData["Entity"]?.ToString() == "Doctor")">
                        Doctor
                    </option>
                    <option value="Appointment"
                            selected="@(ViewData["Entity"]?.ToString() == "Appointment")">
                        Appointment
                    </option>
                    <option value="Prescription"
                            selected="@(ViewData["Entity"]?.ToString() == "Prescription")">
                        Prescription
                    </option>
                    <option value="User"
                            selected="@(ViewData["Entity"]?.ToString() == "User")">
                        User
                    </option>
                    <option value="Role"
                            selected="@(ViewData["Entity"]?.ToString() == "Role")">
                        Role
                    </option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Audit Table -->
<div class="card">
    <div class="card-header">
        <i class="bi bi-list me-2 text-primary"></i>
        Activity Log
        <span class="badge bg-primary-subtle text-primary ms-2">
            @Model.Count() entries
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-clock-history"
                   style="font-size:3rem;opacity:0.3;"></i>
                <p class="mt-3 mb-0">No audit logs found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="auditlogsTable" class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:180px;">Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Changes</th>
                            <th style="width:100px;">IP</th>
                            <th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted">
                                    <small>
                                        @log.Timestamp.ToString("dd MMM yyyy HH:mm:ss")
                                    </small>
                                </td>
                                <td class="fw-semibold">@log.UserName</td>
                                <td>
                                    <span class="badge @log.ActionBadgeClass">
                                        <i class="bi @log.ActionIcon me-1"></i>
                                        @log.Action
                                    </span>
                                </td>
                                <td>
                                    @log.EntityName
                                    @if (log.EntityId.HasValue)
                                    {
                                        <span class="text-muted">#@log.EntityId</span>
                                    }
                                </td>
                                <td class="text-muted">
                                    <small>@(log.Changes ?? "—")</small>
                                </td>
                                <td class="text-muted">
                                    <small>@(log.IpAddress ?? "—")</small>
                                </td>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@log.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {

            initDataTable('#auditlogsTable', {
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 6 }
                ],
                language: {
                    searchPlaceholder: "Search AuditLogs..."
                }
            });

        });
    </script>
    }

