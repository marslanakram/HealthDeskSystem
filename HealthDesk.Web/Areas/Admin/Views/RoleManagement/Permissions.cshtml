@model HealthDesk.Web.Areas.Admin.Controllers.RolePermissionsViewModel
@{
    ViewData["Title"] = "Manage Permissions";
    ViewData["ActiveMenu"] = "Roles";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-key-fill text-primary me-2"></i>
            Manage Permissions — @Model.RoleName
        </h4>
        <p class="text-muted mb-0">Configure what this role can do</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<form asp-action="UpdatePermissions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="RoleId" value="@Model.RoleId" />
    <input type="hidden" name="RoleName" value="@Model.RoleName" />

    @foreach (var category in Model.AllPermissions)
    {
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-folder text-primary me-2"></i>
                <strong>@category.Key</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var permission in category.Value)
                    {
                        var permissionName = permission.Split('.').Last();
                        var isChecked = Model.GrantedPermissions.Contains(permission);

                        <div class="col-md-6 col-lg-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedPermissions"
                                       value="@permission"
                                       id="@permission"
                                       @(isChecked ? "checked" : "") />
                                <label class="form-check-label fw-semibold"
                                       for="@permission">
                                    @permissionName
                                </label>
                                <br />
                                <small class="text-muted">@permission</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 justify-content-end">
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            Cancel
        </a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-lg me-1"></i>Save Permissions
        </button>
    </div>
</form>
