@model IEnumerable<HealthDesk.Domain.Entities.Tenant>
@{
    ViewData["Title"] = "Tenant Management";
    ViewData["ActiveMenu"] = "Tenants";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-building text-primary me-2"></i>
            Tenant Management
        </h4>
        <p class="text-muted mb-0">Manage hospital tenants (Shared Database)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Tenant
    </a>
</div>

<div class="alert alert-info mb-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Current Tenant:</strong>
    @{
        var current = Model.FirstOrDefault(t => t.Id == ViewBag.CurrentTenantId);
    }
    @(current?.Name ?? "Unknown")
    <span class="badge bg-primary ms-2">@(current?.Identifier ?? "N/A")</span>
</div>

<div class="row g-3">
    @foreach (var tenant in Model)
    {
        var isCurrent = tenant.Id == ViewBag.CurrentTenantId;

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 @(isCurrent ? "border-primary" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="fw-bold mb-0">@tenant.Name</h6>
                            <small class="text-muted">@tenant.Identifier</small>
                        </div>
                        @if (isCurrent)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i>Active
                            </span>
                        }
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Tier:</small>
                        <span class="badge bg-primary-subtle text-primary">
                            @tenant.SubscriptionTier
                        </span>
                    </div>

                    @if (!isCurrent)
                    {
                        <form asp-action="SwitchTenant" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tenantId" value="@tenant.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-arrow-left-right me-1"></i>
                                Switch to This Tenant
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
