@model HealthDesk.Web.Areas.SuperAdmin.Controllers.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "SuperAdmin Dashboard";
    ViewData["ActiveMenu"] = "SuperAdminDashboard";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-shield-fill-check text-danger me-2"></i>
            SuperAdmin Dashboard
        </h4>
        <p class="text-muted mb-0">Platform-wide management and monitoring</p>
    </div>
    <span class="badge bg-danger px-3 py-2">
        <i class="bi bi-star-fill me-1"></i>SuperAdmin Access
    </span>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#dc3545,#e83e8c);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="mb-1 text-white-50" style="font-size:0.85rem;">
                        Total Tenants
                    </p>
                    <div class="stat-number">@Model.TotalTenants</div>
                </div>
                <i class="bi bi-building stat-icon"></i>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#198754,#20c997);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="mb-1 text-white-50" style="font-size:0.85rem;">
                        Active Tenants
                    </p>
                    <div class="stat-number">@Model.ActiveTenants</div>
                </div>
                <i class="bi bi-check-circle-fill stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<!-- Tenant List -->
<div class="card">
    <div class="card-header">
        <i class="bi bi-list me-2 text-primary"></i>
        All Tenants (Hospitals)
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hospital</th>
                        <th>Identifier</th>
                        <th>Tier</th>
                        <th>Max Users</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <tr>
                            <td class="fw-semibold">@tenant.Name</td>
                            <td>
                                <span class="badge bg-light text-dark">
                                    @tenant.Identifier
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">
                                    @tenant.SubscriptionTier
                                </span>
                            </td>
                            <td>@tenant.MaxUsers</td>
                            <td>
                                @if (tenant.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-muted">
                                @tenant.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="TenantManagement"
                                   asp-action="SwitchTenant"
                                   asp-route-tenantId="@tenant.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Access
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>