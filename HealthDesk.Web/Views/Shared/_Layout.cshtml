<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HealthDesk</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        :root {
            --primary: #0d6efd;
            --sidebar-width: 260px;
        }

        body { background-color: #f4f6fb; font-family: 'Segoe UI', sans-serif; }

        /* ── Sidebar ── */
        .sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: linear-gradient(180deg, #1a2340 0%, #0d6efd 100%);
            position: fixed;
            top: 0; left: 0;
            z-index: 1000;
            transition: all 0.3s;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-brand h5 {
            color: #fff;
            font-weight: 700;
            margin: 0;
            font-size: 1.2rem;
        }

        .sidebar-brand small { color: rgba(255,255,255,0.6); font-size: 0.75rem; }

        .sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            padding: 0.75rem 1.25rem;
            border-radius: 8px;
            margin: 2px 8px;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

        .sidebar .nav-link i { width: 22px; margin-right: 8px; }

        .sidebar-section-title {
            color: rgba(255,255,255,0.4);
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.75rem 1.25rem 0.25rem;
        }

        /* ── Main content ── */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }

        /* ── Top navbar ── */
        .top-navbar {
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            padding: 0.75rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        /* ── Cards ── */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }

        .card-header {
            background: #fff;
            border-bottom: 1px solid #f0f0f0;
            border-radius: 12px 12px 0 0 !important;
            padding: 1rem 1.25rem;
            font-weight: 600;
        }

        /* ── Stat cards ── */
        .stat-card {
            border-radius: 12px;
            padding: 1.5rem;
            color: #fff;
            border: none;
        }

        .stat-card .stat-icon {
            font-size: 2.5rem;
            opacity: 0.8;
        }

        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 700;
        }

        /* ── Alerts ── */
        .alert { border-radius: 10px; border: none; }

        /* ── Badges ── */
        .badge { font-size: 0.75rem; padding: 5px 10px; border-radius: 6px; }

        /* ── Tables ── */
        .table th {
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            border-top: none;
        }

        .table td { vertical-align: middle; font-size: 0.9rem; }

        /* ── Buttons ── */
        .btn { border-radius: 8px; font-size: 0.875rem; }
        .btn-sm { padding: 0.35rem 0.75rem; }

        /* ── Page header ── */
        .page-header {
            padding: 1.5rem;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            margin-bottom: 1.5rem;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- ── Sidebar ───────────────────────────────────────────── -->
        <div class="sidebar d-flex flex-column">
            <div class="sidebar-brand">
                <h5><i class="bi bi-heart-pulse-fill me-2"></i>HealthDesk</h5>
                <small>Hospital Management</small>
            </div>

            <nav class="flex-grow-1 py-3">
                <ul class="nav flex-column">

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <!-- SuperAdmin Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "SuperAdminDashboard" ? "active" : "")"
                               asp-area="SuperAdmin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-shield-fill-check"></i> SuperAdmin Dashboard
                            </a>
                        </li>

                        <li><div class="sidebar-section-title">Platform Management</div></li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Tenants" ? "active" : "")"
                               asp-area="Admin" asp-controller="TenantManagement" asp-action="Index">
                                <i class="bi bi-building"></i> Tenant Management
                            </a>
                        </li>

                        <li><hr class="my-2 border-white border-opacity-10" /></li>
                    }

                    <!-- Dashboard -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill"></i> Dashboard
                        </a>
                    </li>

                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <li><div class="sidebar-section-title">Management</div></li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Patients" ? "active" : "")"
                               asp-controller="Patient" asp-action="Index">
                                <i class="bi bi-people-fill"></i> Patients
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="Appointment" asp-action="Index">
                                <i class="bi bi-calendar-check-fill"></i> Appointments
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Doctors" ? "active" : "")"
                               asp-controller="Doctor" asp-action="Index">
                                <i class="bi bi-person-badge-fill"></i> Doctors
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Departments" ? "active" : "")"
                               asp-controller="Department" asp-action="Index">
                                <i class="bi bi-building-fill"></i> Departments
                            </a>
                        </li>

                        <li><div class="sidebar-section-title">Administration</div></li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Users" ? "active" : "")"
                               asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                                <i class="bi bi-shield-lock-fill"></i> User Management
                            </a>
                        </li>

                        <!-- Add this -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Roles" ? "active" : "")"
                               asp-area="Admin" asp-controller="RoleManagement" asp-action="Index">
                                <i class="bi bi-shield-check"></i> Role & Permissions
                            </a>
                        </li>

                        <!-- Add this -->
                         <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "AuditLog" ? "active" : "")"
                               asp-area="Admin" asp-controller="AuditLog" asp-action="Index">
                                <i class="bi bi-clock-history"></i> Audit Log
                            </a>
                        </li> 
                    }

                    @if (User.IsInRole("Doctor"))
                    {
                        <li><div class="sidebar-section-title">My Practice</div></li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="Appointment" asp-action="Index">
                                <i class="bi bi-calendar-check-fill"></i> My Appointments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Prescriptions" ? "active" : "")"
                               asp-controller="Prescription" asp-action="Index">
                                <i class="bi bi-file-earmark-medical-fill"></i> Prescriptions
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Patient"))
                    {
                        <li><div class="sidebar-section-title">My Health</div></li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="Appointment" asp-action="Index">
                                <i class="bi bi-calendar-check-fill"></i> My Appointments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Prescriptions" ? "active" : "")"
                               asp-controller="Prescription" asp-action="Index">
                                <i class="bi bi-file-earmark-medical-fill"></i> My Prescriptions
                            </a>
                        </li>
                    }

            </ul>
        </nav>

        <!-- Sidebar footer -->
        <div class="p-3 border-top border-white border-opacity-10">
            <div class="d-flex align-items-center mb-2">
                <div class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center
                            justify-content-center me-2"
                     style="width:36px;height:36px;">
                    <i class="bi bi-person-fill text-white"></i>
                </div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:0.85rem;">
                        @User.Identity!.Name
                    </div>
                    <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);">
                        @(User.IsInRole("Admin") ? "Administrator" :
                                                User.IsInRole("Doctor") ? "Doctor" :
                                                User.IsInRole("Receptionist") ? "Receptionist" :
                                                User.IsInRole("Nurse") ? "Nurse" : "Patient")
                    </div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-sm w-100 text-white border-white border-opacity-25">
                    <i class="bi bi-box-arrow-left me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </div>

        <!-- ── Main content ──────────────────────────────────────── -->
        <div class="main-content">
            <!-- Top navbar -->
            <div class="top-navbar d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-semibold text-secondary">
                    @ViewData["Title"]
                </h6>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted" style="font-size:0.85rem;">
                        <i class="bi bi-calendar3 me-1"></i>
                        @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                    </span>
                </div>
            </div>

            <!-- Page content -->
            <div class="p-4">
                <!-- Global alert messages -->
            @if (TempData["Success"] is not null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
