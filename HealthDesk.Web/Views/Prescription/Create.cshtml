@model HealthDesk.Application.DTOs.CreatePrescriptionDto
@{
    ViewData["Title"] = "Create Prescription";
    ViewData["ActiveMenu"] = "Prescriptions";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-medical-fill text-primary me-2"></i>
            Create Prescription
        </h4>
        <p class="text-muted mb-0">Write a medical prescription</p>
    </div>
    <a asp-controller="Appointment"
       asp-action="Details"
       asp-route-id="@Model.AppointmentId"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Appointment
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <!-- Appointment Context -->
        <div class="card mb-4 border-primary border-opacity-25">
            <div class="card-body py-3">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <div class="rounded-circle d-flex align-items-center
                                    justify-content-center"
                             style="width:42px;height:42px;
                                    background:linear-gradient(
                                    135deg,#0d6efd,#6610f2);">
                            <i class="bi bi-calendar-check-fill text-white"></i>
                        </div>
                    </div>
                    <div class="col">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <small class="text-muted d-block">Patient</small>
                                <span class="fw-semibold">@ViewBag.PatientName</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Doctor</small>
                                <span class="fw-semibold">Dr. @ViewBag.DoctorName</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Appointment</small>
                                <span class="fw-semibold">@ViewBag.AppointmentDate</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="AppointmentId" type="hidden" />
            <input asp-for="PatientId" type="hidden" />
            <input asp-for="DoctorId" type="hidden" />

            <!-- Diagnosis -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-file-text me-2 text-primary"></i>
                    Diagnosis
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Diagnosis"
                               class="form-label fw-semibold">
                            Primary Diagnosis <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Diagnosis"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter primary diagnosis...">
                        </textarea>
                        <span asp-validation-for="Diagnosis"
                              class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Medicines -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-capsule me-2 text-primary"></i>
                    Medications
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Medicines"
                               class="form-label fw-semibold">
                            Prescribed Medicines <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Medicines"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Example:&#10;1. Amoxicillin 500mg - 1 tablet 3x daily for 7 days&#10;2. Ibuprofen 400mg - 1 tablet as needed for pain">
                        </textarea>
                        <span asp-validation-for="Medicines"
                              class="text-danger small"></span>
                        <small class="form-text text-muted">
                            List each medication with dosage, frequency, and duration
                        </small>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Instructions"
                               class="form-label fw-semibold">
                            Additional Instructions
                        </label>
                        <textarea asp-for="Instructions"
                                  class="form-control"
                                  rows="2"
                                  placeholder="e.g., Take with food, avoid alcohol...">
                        </textarea>
                    </div>
                </div>
            </div>

            <!-- Lab Tests & Follow Up -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-clipboard-pulse me-2 text-primary"></i>
                    Tests & Follow Up
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="LabTests"
                                   class="form-label fw-semibold">
                                Lab Tests
                            </label>
                            <textarea asp-for="LabTests"
                                      class="form-control"
                                      rows="2"
                                      placeholder="e.g., Complete Blood Count, X-Ray Chest PA">
                            </textarea>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FollowUpDate"
                                   class="form-label fw-semibold">
                                Follow Up Date
                            </label>
                            <input asp-for="FollowUpDate"
                                   type="date"
                                   class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-controller="Appointment"
                   asp-action="Details"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Save Prescription
                </button>
            </div>
        </form>
    </div>
</div>
