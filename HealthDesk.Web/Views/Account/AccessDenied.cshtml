@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center"
     style="background: linear-gradient(135deg, #1a2340 0%, #0d6efd 100%);">

    <div class="text-center text-white p-4">
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill" style="font-size: 5rem; opacity: 0.8;"></i>
        </div>
        <h1 class="display-4 fw-bold">403</h1>
        <h4 class="fw-semibold mb-3">Access Denied</h4>
        <p class="text-white-50 mb-4" style="max-width: 400px; margin: 0 auto;">
            You do not have permission to access this page.
            Please contact your administrator if you believe this is a mistake.
        </p>
        <a asp-controller="Dashboard" asp-action="Index"
           class="btn btn-light fw-semibold px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

</div>
