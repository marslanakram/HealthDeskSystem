@model HealthDesk.Application.DTOs.UpdateDoctorDto
@{
    ViewData["Title"] = "Edit Doctor";
    ViewData["ActiveMenu"] = "Doctors";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-pencil-fill text-primary me-2"></i>Edit Doctor
        </h4>
        <p class="text-muted mb-0">Update doctor information</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pencil-square me-2 text-primary"></i>
                Doctor Information
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Full Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Specialization"
                                   class="form-label fw-semibold">
                                Specialization <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Specialization"
                                   class="form-control" />
                            <span asp-validation-for="Specialization"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Qualification"
                                   class="form-label fw-semibold">
                                Qualification
                            </label>
                            <input asp-for="Qualification"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>
                            <input asp-for="PhoneNumber"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId"
                                   class="form-label fw-semibold">
                                Department <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.Departments"
                                    class="form-select"></select>
                            <span asp-validation-for="DepartmentId"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Shift"
                                   class="form-label fw-semibold">
                                Shift
                            </label>
                            <select asp-for="Shift"
                                    asp-items="Html.GetEnumSelectList<HealthDesk.Domain.Enums.ShiftType>()"
                                    class="form-select"></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConsultationFee"
                                   class="form-label fw-semibold">
                                Consultation Fee ($)
                            </label>
                            <input asp-for="ConsultationFee"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input asp-for="IsAvailable"
                                       class="form-check-input"
                                       type="checkbox" />
                                <label asp-for="IsAvailable"
                                       class="form-check-label fw-semibold">
                                    Available for Appointments
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Update Doctor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>