@model HealthDesk.Application.DTOs.DepartmentDto
@{
    ViewData["Title"] = "Department Details";
    ViewData["ActiveMenu"] = "Departments";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-building-fill text-primary me-2"></i>@Model.Name
        </h4>
        <p class="text-muted mb-0">Department details</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-info-circle me-2 text-primary"></i>
                Basic Information
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted fw-semibold" style="width:140px;">
                            Name
                        </td>
                        <td class="fw-semibold">@Model.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Location</td>
                        <td>@(Model.Location ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Doctors</td>
                        <td>
                            <span class="badge bg-info-subtle text-info">
                                @Model.DoctorCount doctor(s)
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Status</td>
                        <td>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">
                                    Inactive
                                </span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Created</td>
                        <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-card-text me-2 text-primary"></i>
                Description
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted mb-0">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">
                        No description provided.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
