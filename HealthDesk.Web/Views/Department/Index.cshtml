@model IEnumerable<HealthDesk.Application.DTOs.DepartmentDto>
@{
    ViewData["Title"] = "Departments";
    ViewData["ActiveMenu"] = "Departments";
}

<!-- Page Header -->
<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-building-fill text-primary me-2"></i>Departments
        </h4>
        <p class="text-muted mb-0">Manage hospital departments</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Department
    </a>
</div>

<!-- Search -->
