<!-- Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-table me-2 text-primary"></i>
            All Departments
            <span class="badge bg-primary-subtle text-primary ms-2">
                @Model.Count()
            </span>
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-building" style="font-size:3rem;opacity:0.3;"></i>
                <p class="mt-3 mb-0">No departments found.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    Add First Department
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="departmentsTable" class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            @* <th>#</th> *@
                            <th>Name</th>
                            <th>Location</th>
                            <th>Description</th>
                            <th>Doctors</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in Model)
                        {
                            <tr>
                                @* <td class="text-muted">@dept.Id</td> *@
                                <td class="fw-semibold">@dept.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(dept.Location))
                                    {
                                        <span>
                                            <i class="bi bi-geo-alt text-muted me-1"></i>
                                            @dept.Location
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-muted" style="max-width:200px;">
                                    <span class="text-truncate d-block">
                                        @(dept.Description ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">
                                        <i class="bi bi-person-badge me-1"></i>
                                        @dept.DoctorCount
                                    </span>
                                </td>
                                <td>
                                    @if (dept.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@dept.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@dept.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                onclick="confirmDelete(@dept.Id, '@dept.Name')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    Confirm Delete
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    Are you sure you want to delete
                    <strong id="deleteName"></strong>?
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            initDataTable('#departmentsTable', {
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 5 }
                ],
                language: {
                    searchPlaceholder: "Search departments..."
                }
            });

        });
    </script>
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteName').textContent = name;
            document.getElementById('deleteForm').action =
                '/Department/Delete/' + id;
            new bootstrap.Modal(
                document.getElementById('deleteModal')).show();
        }
    </script>
}
