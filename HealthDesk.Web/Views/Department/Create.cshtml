@model HealthDesk.Application.DTOs.CreateDepartmentDto
@{
    ViewData["Title"] = "Add Department";
    ViewData["ActiveMenu"] = "Departments";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-building-fill text-primary me-2"></i>Add Department
        </h4>
        <p class="text-muted mb-0">Create a new hospital department</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pencil-square me-2 text-primary"></i>
                Department Information
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Department Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Cardiology" />
                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-semibold">
                            Location
                        </label>
                        <input asp-for="Location"
                               class="form-control"
                               placeholder="e.g. Block A, Floor 2" />
                        <span asp-validation-for="Location"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">
                            Description
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Brief description of this department...">
                        </textarea>
                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Save Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>