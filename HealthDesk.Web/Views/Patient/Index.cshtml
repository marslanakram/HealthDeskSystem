@model IEnumerable<HealthDesk.Application.DTOs.PatientDto>
@{
    ViewData["Title"] = "Patients";
    ViewData["ActiveMenu"] = "Patients";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Patients
        </h4>
        <p class="text-muted mb-0">Manage registered patients</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Register Patient
    </a>
</div>

