<!-- Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-table me-2 text-primary"></i>
            All Patients
            <span class="badge bg-primary-subtle text-primary ms-2">
                @Model.Count()
            </span>
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people"
                   style="font-size:3rem;opacity:0.3;"></i>
                <p class="mt-3 mb-0">No patients found.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    Register First Patient
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="patientsTable" class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Patient</th>
                            <th>Contact</th>
                            <th>Age / Gender</th>
                            <th>Blood Group</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex
                                                            align-items-center
                                                            justify-content-center
                                                            me-2 flex-shrink-0"
                                             style="width:38px;height:38px;
                                                            background:linear-gradient(
                                                            135deg,#0d6efd,#6610f2);">
                                            <span class="text-white fw-bold"
                                                  style="font-size:0.8rem;">
                                                @patient.FullName[0]
                                            </span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">
                                                @patient.FullName
                                            </div>
                                            <small class="text-muted">
                                                @patient.Email
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                                    {
                                        <span>
                                            <i class="bi bi-telephone
                                                                   text-muted me-1"></i>
                                            @patient.PhoneNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span>@patient.Age yrs</span>
                                    <span class="badge bg-light text-dark ms-1">
                                        @patient.GenderDisplay
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger">
                                        @patient.BloodGroupDisplay
                                    </span>
                                </td>
                                <td>
                                    @if (patient.IsActive)
                                    {
                                        <span class="badge
                                                                 bg-success-subtle
                                                                 text-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                                 bg-secondary-subtle
                                                                 text-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-muted">
                                    @patient.CreatedAt.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                onclick="confirmDelete(
                                                            @patient.Id,
                                                            '@patient.FullName')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle-fill
                               text-danger me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    Are you sure you want to remove
                    <strong id="deleteName"></strong>?
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            initDataTable('#patientsTable', {
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 6 }
                ],
                language: {
                    searchPlaceholder: "Search patients..."
                }
            });

        });
    </script>
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteName').textContent = name;
            document.getElementById('deleteForm').action =
                '/Patient/Delete/' + id;
            new bootstrap.Modal(
                document.getElementById('deleteModal')).show();
        }
    </script>
}
