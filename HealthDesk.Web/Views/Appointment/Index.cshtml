@model IEnumerable<HealthDesk.Application.DTOs.AppointmentDto>
@{
    ViewData["Title"] = "Appointments";
    ViewData["ActiveMenu"] = "Appointments";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-calendar-check-fill text-primary me-2"></i>
            Appointments
        </h4>
        <p class="text-muted mb-0">
            @DateTime.Today.ToString("dddd, dd MMMM yyyy")
        </p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Book Appointment
        </a>
    }
</div>

<!-- Status Filter Pills -->
<div class="d-flex gap-2 mb-4 flex-wrap">
    <span class="badge bg-primary px-3 py-2"
          style="cursor:pointer;font-size:0.85rem;">
        All
        <span class="badge bg-white text-primary ms-1">
            @Model.Count()
        </span>
    </span>
    <span class="badge bg-warning-subtle text-warning px-3 py-2"
          style="cursor:pointer;font-size:0.85rem;">
        Pending
        <span class="badge bg-warning text-white ms-1">
            @Model.Count(a => a.Status ==
            HealthDesk.Domain.Enums.AppointmentStatus.Pending)
        </span>
    </span>
    <span class="badge bg-success-subtle text-success px-3 py-2"
          style="cursor:pointer;font-size:0.85rem;">
        Confirmed
        <span class="badge bg-success text-white ms-1">
            @Model.Count(a => a.Status ==
                        HealthDesk.Domain.Enums.AppointmentStatus.Confirmed)
        </span>
    </span>
    <span class="badge bg-info-subtle text-info px-3 py-2"
          style="cursor:pointer;font-size:0.85rem;">
        Completed
        <span class="badge bg-info text-white ms-1">
            @Model.Count(a => a.Status ==
                        HealthDesk.Domain.Enums.AppointmentStatus.Completed)
        </span>
    </span>
    <span class="badge bg-danger-subtle text-danger px-3 py-2"
          style="cursor:pointer;font-size:0.85rem;">
        Cancelled
        <span class="badge bg-danger text-white ms-1">
            @Model.Count(a => a.Status ==
                        HealthDesk.Domain.Enums.AppointmentStatus.Cancelled)
        </span>
    </span>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x"
                   style="font-size:3rem;opacity:0.3;"></i>
                <p class="mt-3 mb-0">No appointments found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="appointmentsTable" class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date & Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th>Fee</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @(appt.AppointmentDate
                                            .ToString("dd MMM yyyy"))

                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>
                                        @appt.TimeDisplay
                                    </small>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        @appt.PatientName
                                    </div>
                                </td>
                                <td>
                                    <div>Dr. @appt.DoctorName</div>
                                </td>
                                <td class="text-muted">
                                    @appt.DepartmentName
                                </td>
                                <td>
                                    @{
                                        var (badgeClass, icon) = appt.Status switch
                                        {
                                            HealthDesk.Domain.Enums
                                            .AppointmentStatus.Pending
                                            => ("bg-warning-subtle text-warning",
                                            "bi-hourglass-split"),
                                            HealthDesk.Domain.Enums
                                            .AppointmentStatus.Confirmed
                                            => ("bg-success-subtle text-success",
                                            "bi-check-circle"),
                                            HealthDesk.Domain.Enums
                                            .AppointmentStatus.Completed
                                            => ("bg-info-subtle text-info",
                                            "bi-check-circle-fill"),
                                            HealthDesk.Domain.Enums
                                            .AppointmentStatus.Cancelled
                                            => ("bg-danger-subtle text-danger",
                                            "bi-x-circle"),
                                            _ => ("bg-secondary-subtle text-secondary",
                                            "bi-dash-circle")
                                        };
                                    }
                                    <span class="badge @badgeClass">
                                        <i class="bi @icon me-1"></i>
                                        @appt.StatusDisplay
                                    </span>
                                </td>
                                <td>
                                    @if (appt.Fee.HasValue)
                                    {
                                        <span class="@(appt.IsPaid ?
                                                                                          "text-success fw-semibold" :
                                                                                          "text-warning fw-semibold")">
                                $@appt.Fee.Value.ToString("F2")
                                @if (appt.IsPaid)
                                            {
                                                <i class="bi bi-check-circle-fill ms-1"></i>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@appt.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") ||
                                                                        User.IsInRole("Receptionist"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@appt.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {

            initDataTable('#appointmentsTable', {
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 6 }
                ],
                language: {
                    searchPlaceholder: "Search appointments..."
                }
            });

        });
    </script>
}